; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="JuggyVRGame"
run/main_scene="res://scenes/Town.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

XRToolsUserSettings="*res://addons/godot-xr-tools/user_settings/user_settings.gd"
XRToolsRumbleManager="*res://addons/godot-xr-tools/rumble/rumble_manager.gd"

[display]

window/subwindows/embed_subwindows=false

[editor_plugins]

enabled=PackedStringArray("res://addons/godot-xr-tools/plugin.cfg")

[filesystem]

import/blender/enabled=false

[xr]

openxr/enabled=true
shaders/enabled=true

[rendering]

; Volumetric fog froxel grid. Lowered from the 64x64x64 default because
; volumetric fog is evaluated per eye in VR and this project has an open
; frame-rate question — see scripts/fog_banks.gd. Raise for finer plume
; detail, lower if PERF says the GPU is the bottleneck.
environment/volumetric_fog/volume_size=48
environment/volumetric_fog/volume_depth=64
environment/volumetric_fog/use_filter=1
